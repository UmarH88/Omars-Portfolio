---
/*
  Bookcase: one walnut bookcase with 4 shelves of books, drawn with plain HTML + CSS.
  Books get their colour, width and height from a small "seeded" random generator:
  the same seed always gives the same books, so the shelves look varied but never
  change between visits or builds.
  A wing bookcase has a gold plaque on top; the Quran wing's first book is the special
  green-and-gold Quran (it gets its own animation later).
*/
import T from './T.astro';

interface Props {
  seed: number;
  label?: { en: string; id: string }; // wing name on the plaque (none = plain bookcase)
  quran?: boolean; // put the special Quran book first
}

const { seed, label, quran = false } = Astro.props;

// mulberry32: tiny seeded random generator, returns numbers from 0 to 1
function random(seedValue: number) {
  let a = seedValue;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Book colours from the design: deep reds, navy, forest green, ochre, brown, plum
const COLOURS = ['#6b2a2a', '#7a3b2e', '#26375c', '#2f4f3e', '#8a6a2f', '#5a3a26', '#4a2e4f', '#3d4a5c', '#9b7a3a'];
const SHELVES = 4;
const BOOKS_PER_SHELF = 11;

const next = random(seed);
const shelves = Array.from({ length: SHELVES }, (_, s) =>
  Array.from({ length: BOOKS_PER_SHELF }, (_, b) => ({
    colour: COLOURS[Math.floor(next() * COLOURS.length)],
    width: 0.62 + next() * 0.5, // in rem
    height: 68 + next() * 28, // % of the shelf height
    lean: s === 2 && b === BOOKS_PER_SHELF - 1 ? -8 : 0, // one leaning book, for a lived-in look
  })),
);
---

<div class:list={['bookcase', { wing: label }]}>
  {
    label && (
      <div class="plaque">
        <T en={label.en} id={label.id} />
      </div>
    )
  }
  <div class="shelves">
    {
      shelves.map((books, s) => (
        <div class="shelf">
          {s === 0 && quran && (
            <span class="book quran-book" aria-hidden="true" style="--w: 1.15rem; --h: 92%" />
          )}
          {books.map((book) => (
            <span
              class="book"
              aria-hidden="true"
              style={`--c: ${book.colour}; --w: ${book.width}rem; --h: ${book.height}%; --lean: ${book.lean}deg`}
            />
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .bookcase {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.5rem;
    border-radius: 4px;
    /* walnut frame: lighter grain in the middle, darker edges */
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.45), transparent 12%, transparent 88%, rgb(0 0 0 / 0.45)),
      linear-gradient(#4a3322, #2c1d12);
    box-shadow: inset 0 0 0 2px #1a110a, 0 10px 30px rgb(0 0 0 / 0.5);
  }

  /* Gold-edged name plaque at the top of a wing */
  .plaque {
    margin: 0.1rem auto 0.5rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--gold-300) 70%, transparent);
    border-radius: 3px;
    background: linear-gradient(#24170e, #170f09);
    color: var(--gold-300);
    font-family: var(--font-library);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }

  .shelves {
    flex: 1;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 0.45rem;
  }

  /* One shelf: books stand on a wooden plank (the bottom border) */
  .shelf {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    overflow: hidden;
    padding: 0 0.3rem;
    border-bottom: 0.45rem solid #5c4029;
    background: linear-gradient(#120b06, #1f150d); /* dark inside of the case */
    box-shadow: inset 0 6px 10px rgb(0 0 0 / 0.6);
  }

  .book {
    flex-shrink: 0;
    width: var(--w);
    height: var(--h);
    border-radius: 2px 2px 0 0;
    /* spine: colour + light from the left + two thin gold bands */
    background:
      linear-gradient(transparent 14%, rgb(232 196 124 / 0.55) 14% 16%, transparent 16% 80%, rgb(232 196 124 / 0.4) 80% 82%, transparent 82%),
      linear-gradient(90deg, rgb(255 255 255 / 0.12), transparent 40%, rgb(0 0 0 / 0.3)),
      var(--c);
    transform: rotate(var(--lean, 0deg));
    transform-origin: bottom left;
  }

  /* The Quran: green with a gold band and a soft glow */
  .quran-book {
    background:
      linear-gradient(transparent 40%, var(--gold-300) 40% 48%, transparent 48%),
      linear-gradient(90deg, rgb(255 255 255 / 0.15), transparent 45%, rgb(0 0 0 / 0.3)),
      #1f6a4c;
    box-shadow: 0 0 12px 2px rgb(232 196 124 / 0.55);
    animation: glow 3s ease-in-out infinite;
  }

  @keyframes glow {
    50% {
      box-shadow: 0 0 18px 4px rgb(232 196 124 / 0.75);
    }
  }
</style>
