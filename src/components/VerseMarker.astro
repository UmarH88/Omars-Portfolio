---
/*
  VerseMarker: the round verse-end sign with the verse number in Arabic digits.
  Screen readers hear "Verse 5" instead of the Arabic digit.
*/
import { arabicNumber } from '../lib/quran';

interface Props {
  number: number;
}

const { number } = Astro.props;
---

<span class="verse-marker" role="img" aria-label={`Verse ${number}`}>{arabicNumber(number)}</span>

<style>
  .verse-marker {
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    height: 1.6em;
    margin-inline: 0.15em;
    padding-inline: 0.2em;
    border: 1.5px solid var(--highlight);
    border-radius: 999px;
    /* double ring: an inner line in the accent colour */
    box-shadow: inset 0 0 0 2px var(--surface), inset 0 0 0 3px var(--accent);
    color: var(--accent);
    font-family: var(--font-arabic);
    font-size: 0.6em;
    line-height: 1;
    vertical-align: middle;
  }
</style>
