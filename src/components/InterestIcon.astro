---
/*
  InterestIcon: the small line icons inside the orbit badges.
  Decorative only (aria-hidden): the badge button carries the name.
*/
export type InterestIconName = 'plane' | 'quran' | 'atom' | 'code' | 'languages' | 'planet';

interface Props {
  name: InterestIconName;
}
const { name } = Astro.props;
---

{
  name === 'languages' ? (
    <span class="languages" aria-hidden="true">
      Aa <span lang="ar">ع</span>
    </span>
  ) : (
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {name === 'plane' && (
        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
      )}
      {name === 'quran' && (
        <Fragment>
          <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z" />
          <path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />
        </Fragment>
      )}
      {name === 'atom' && (
        <Fragment>
          <circle cx="12" cy="12" r="1" />
          <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z" />
          <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z" />
        </Fragment>
      )}
      {name === 'code' && (
        <Fragment>
          <rect x="3" y="4" width="18" height="12" rx="2" />
          <path d="M2 20h20M10 8.5 8 10l2 1.5M14 8.5l2 1.5-2 1.5" />
        </Fragment>
      )}
      {name === 'planet' && (
        <Fragment>
          <circle cx="12" cy="12" r="5" />
          <ellipse cx="12" cy="12" rx="10.5" ry="3.5" transform="rotate(-20 12 12)" />
        </Fragment>
      )}
    </svg>
  )
}

<style>
  .languages {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .languages span {
    margin-inline-start: 0.1em;
    color: var(--purple-300);
    font-size: 1.15em;
  }
</style>
