---
/*
  Study mode: /quran/1/study ... /quran/114/study
  One ayah per row: Arabic with tappable words, then the translation.
  "Words under Arabic" toggle prints each word's meaning beneath it.
  Side panel (beside the verses on wide screens, below them on phones) with tabs:
  Tafseer (surahs with downloaded tafsir, npm run fetch:tafsir) and Quiz (every surah,
  questions generated from the data by lib/quiz.ts).
*/
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/Quiz.astro';
import LanguageSwitch from '../../../components/LanguageSwitch.astro';
import QuranWord from '../../../components/QuranWord.astro';
import StudyVerse from '../../../components/StudyVerse.astro';
import T from '../../../components/T.astro';
import TafseerPanel from '../../../components/TafseerPanel.astro';
import {
  chapters,
  getChapter,
  getSurah,
  getSimpleTafsir,
  getTafsir,
  hasSurahData,
  mushafUrl,
  placeLabel,
  studyRows,
} from '../../../lib/quran';
import { buildQuiz, quizExtra } from '../../../lib/quiz';

export function getStaticPaths() {
  return chapters
    .filter((chapter) => hasSurahData(chapter.id))
    .map((chapter) => ({ params: { surah: String(chapter.id) } }));
}

const id = Number(Astro.params.surah);
const surah = await getSurah(id);
const rows = studyRows(surah);
const langs = surah.languages.map((l) => l.lang); // ["en", "id"]
const tafsir = await getTafsir(id); // null if not downloaded for this surah
const simpleTafsir = await getSimpleTafsir(id); // the easy version, if written yet

// Bismillah above the surah: words of 1:1 from the API (never typed by hand).
// Al-Fatihah shows it as its first row instead; At-Tawbah has none.
const bismillah = id !== 1 && surah.bismillahPre ? (await getSurah(1)).verses[0] : null;

// Quiz: this surah's words and verses; nearby surahs only supply extra wrong options
const neighbours = [id - 2, id - 1, id + 1, id + 2].filter((n) => n >= 1 && n <= 114 && hasSurahData(n));
const extra = quizExtra(
  await Promise.all(
    neighbours.map(async (n) => {
      const other = await getSurah(n);
      return { name: other.nameSimple, rows: studyRows(other) };
    }),
  ),
);
const questions = buildQuiz(id, rows, extra);

const shownVerses = id === 1 ? 7 : surah.versesCount; // Al-Fatihah: 7 without the Bismillah
const place = placeLabel(surah.revelationPlace);
const { translatedNames } = getChapter(id)!; // the meanings live in chapters.json
const details = {
  en: `${translatedNames.en} · ${place} · ${shownVerses} verses`,
  id: `${translatedNames.id} · ${place} · ${shownVerses} ayat`,
};
---

<Base
  title={`${surah.nameSimple} · Study`}
  description={`Study Surah ${surah.nameSimple} (${surah.meaning}) verse by verse, with word-by-word meanings and translation.`}
  theme="space"
  fonts={['arabic', 'library']}
>
  <main class="study has-panel">
    <nav class="top" aria-label="Surah navigation">
      <a href="/quran">← <T en="All surahs" id="Semua surah" /></a>
      <a class="pill" href={mushafUrl(id)}><T en="Mushaf view" id="Tampilan mushaf" /></a>
    </nav>

    <header class="head">
      <span class="badge" aria-hidden="true">{surah.id}</span>
      <div class="names">
        <h1><span class="sr-only">Surah {surah.id}: </span>{surah.nameSimple}</h1>
        <p><T en={details.en} id={details.id} /></p>
      </div>
      <p class="arabic-name" lang="ar" dir="rtl">سورة {surah.nameArabic}</p>
    </header>

    <div class="controls">
      <LanguageSwitch />
      <!-- aria-pressed tells screen readers whether the toggle is on -->
      <button type="button" class="pill toggle" id="words-toggle" aria-pressed="false">
        <T en="Words under Arabic" id="Arti di bawah kata" />:
        <!-- CSS shows "On" or "Off" from aria-pressed, in the active language -->
        <span class="state-on"><T en="On" id="Aktif" /></span><span class="state-off"><T en="Off" id="Mati" /></span>
      </button>
    </div>

    <div class="columns">
      <div class="reading">
        {
          bismillah && (
            <p class="bismillah" lang="ar" dir="rtl">
              {bismillah.words.map((word) => <Fragment><QuranWord word={word} langs={langs} />{' '}</Fragment>)}
            </p>
          )
        }

        <p class="hint">
          <T
            en="Hover over an Arabic word (or tap it on a phone) to see what it means."
            id="Arahkan kursor ke kata Arab (atau ketuk di ponsel) untuk melihat artinya."
          />
        </p>

        <div class="verses" id="verses">
          {rows.map((row) => <StudyVerse row={row} langs={langs} explain={tafsir !== null} />)}
        </div>
      </div>

      <aside class="panel" aria-label="Study tools">
        {
          tafsir && (
            <div class="tabs" role="tablist" aria-label="Study tools">
              <button type="button" role="tab" id="tab-tafseer" aria-controls="pane-tafseer" aria-selected="true">
                <T en="Tafseer" id="Tafsir" />
              </button>
              <button type="button" role="tab" id="tab-quiz" aria-controls="pane-quiz" aria-selected="false" tabindex="-1">
                <T en="Quiz" id="Kuis" />
              </button>
            </div>
          )
        }
        {
          tafsir && (
            <div role="tabpanel" id="pane-tafseer" aria-labelledby="tab-tafseer">
              <TafseerPanel data={tafsir} simple={simpleTafsir} versesCount={surah.versesCount} langs={langs} />
            </div>
          )
        }
        <div role={tafsir ? 'tabpanel' : undefined} id="pane-quiz" aria-labelledby={tafsir ? 'tab-quiz' : undefined} hidden={tafsir !== null}>
          {!tafsir && <h2 class="panel-title"><T en="Quiz" id="Kuis" /></h2>}
          <Quiz surah={id} questions={questions} />
        </div>
      </aside>
    </div>

    <footer>
      {
        surah.languages.map(({ lang, name }) => (
          <p class="credit" data-lang={lang}><T en="Translation" id="Terjemahan" />: {name}.</p>
        ))
      }
      <p>
        <T
          en="Arabic text, word meanings and translations from the"
          id="Teks Arab, arti kata, dan terjemahan dari"
        />
        <a href="https://quran.com">Quran.com</a> / Quran Foundation API.
      </p>
    </footer>
  </main>
</Base>

<script>
  // Panel tabs (Tafseer | Quiz): click, or arrow keys to move between tabs
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function selectTab(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      selectTab(next);
      next.focus();
    });
  });
  // "Explain verse" buttons need the Tafseer tab, so switch back to it when one is pressed
  document.querySelectorAll('[data-explain]').forEach((button) =>
    button.addEventListener('click', () => tabs[0] && selectTab(tabs[0])),
  );

  // "Words under Arabic" toggle. The choice is remembered between visits.
  const KEY = 'study-words-under';
  const toggle = document.getElementById('words-toggle')!;
  const verses = document.getElementById('verses')!;

  function apply(on: boolean) {
    verses.classList.toggle('words-under', on);
    toggle.setAttribute('aria-pressed', String(on)); // CSS shows "On"/"Off" from this
  }

  // localStorage can fail (private mode, blocked storage), so the page works without it
  let saved = false;
  try {
    saved = localStorage.getItem(KEY) === 'on';
  } catch {}
  apply(saved);

  toggle.addEventListener('click', () => {
    const on = toggle.getAttribute('aria-pressed') !== 'true';
    apply(on);
    try {
      localStorage.setItem(KEY, on ? 'on' : 'off');
    } catch {}
  });
</script>

<style>
  .study {
    max-width: 46rem;
    margin-inline: auto;
    padding: 1rem var(--gutter) 3rem;
  }

  /* ---- Verses + panel ---- */
  /* Phone: one column, panel after the verses */
  .columns {
    display: grid;
    gap: 2rem;
  }

  /* Tafseer | Quiz tabs: the active one is cyan, like the design */
  .tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }

  .tabs button {
    flex: 1;
    min-height: 2.6rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
  }

  .tabs button[aria-selected='true'] {
    background: var(--accent);
    color: var(--navy-950);
  }

  .panel-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-library);
    font-size: 1.6rem;
  }

  .panel {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  /* Wide screens: panel beside the verses, staying in view while you scroll */
  @media (min-width: 64rem) {
    .study.has-panel {
      max-width: 76rem;
    }

    .has-panel .columns {
      grid-template-columns: minmax(0, 1fr) 26rem;
      align-items: start;
    }

    .panel {
      position: sticky;
      top: 1rem;
      max-height: calc(100dvh - 2rem);
      overflow-y: auto; /* long tafsir scrolls inside the panel */
    }
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top a:first-child {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  /* Small outlined pills, like the screenshot's toggles */
  .pill {
    padding: 0.45rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--text) 25%, transparent);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text);
    font: 600 0.9rem/1 var(--font-ui);
    text-decoration: none;
    cursor: pointer;
  }

  .toggle[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Show "On" or "Off" depending on the toggle's state */
  .toggle[aria-pressed='true'] .state-off,
  .toggle[aria-pressed='false'] .state-on {
    display: none;
  }

  /* ---- Header: badge | names | Arabic name ---- */
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'badge names'
      'arabic arabic';
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.75rem;
  }

  .badge {
    grid-area: badge;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--highlight);
    border-radius: 50%;
    color: var(--highlight);
    font-family: var(--font-display);
  }

  .names {
    grid-area: names;
  }

  h1 {
    font-family: var(--font-library);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 600;
  }

  .names p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .arabic-name {
    grid-area: arabic;
    margin: 0;
    color: var(--highlight);
    font-size: clamp(2rem, 9vw, 2.8rem);
    text-align: right;
  }

  @media (min-width: 48rem) {
    .head {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'badge names arabic';
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  /* Credit only the translation that's showing */
  .credit {
    display: none;
  }

  :global(html:not(.lang-id)) .credit[data-lang='en'],
  :global(html.lang-id) .credit[data-lang='id'] {
    display: block;
  }

  footer p {
    margin: 0.25rem 0;
  }

  .bismillah {
    margin: 1.5rem 0 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    font-size: clamp(1.9rem, 8vw, 2.6rem);
    text-align: center;
  }

  .hint {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  footer {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.88rem;
    text-align: center;
  }
</style>
