---
/*
  Mushaf, Surah mode: /quran/1 ... /quran/114
  One surah on its own, still printed on its real mushaf lines: we show the
  mushaf pages it's on, keeping only its own lines.
  The switch at the top goes to Page mode (/mushaf/[page]), the full printed pages.
*/
import Base from '../../layouts/Base.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import MushafModeSwitch from '../../components/MushafModeSwitch.astro';
import MushafPage from '../../components/MushafPage.astro';
import T from '../../components/T.astro';
import { chapters, getMushafPage, placeLabel, studyUrl, surahPageUrl } from '../../lib/quran';

export function getStaticPaths() {
  return chapters.map((chapter) => ({ params: { surah: String(chapter.id) }, props: { chapter } }));
}

const { chapter } = Astro.props;
const [firstPage, lastPage] = chapter.pages;
const pages = await Promise.all(
  Array.from({ length: lastPage - firstPage + 1 }, (_, i) => getMushafPage(firstPage + i)),
);

const juzList = [...new Set(pages.map((p) => p.juz))];
const juzLabel = juzList.length === 1 ? `Juz ${juzList[0]}` : `Juz ${juzList[0]}–${juzList.at(-1)}`;
const versesShown = chapter.id === 1 ? 7 : chapter.versesCount; // Al-Fatihah: 7 without the Bismillah
---

<Base
  title={`${chapter.nameSimple} · Mushaf`}
  description={`Surah ${chapter.nameSimple} (${chapter.meaning}) in the mushaf. Tap a word to see its meaning.`}
  theme="mushaf"
  fonts={['arabic']}
>
  <header class="bar">
    <a class="round" href="/quran" aria-label="Back to all surahs">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" />
      </svg>
    </a>
    <div class="names">
      <h1>
        {chapter.id}. {chapter.nameSimple}
        <span>(<T en={chapter.translatedNames.en} id={chapter.translatedNames.id} />)</span>
      </h1>
      <p>
        <T
          en={`${placeLabel(chapter.revelationPlace)} · ${versesShown} verses · ${juzLabel}`}
          id={`${placeLabel(chapter.revelationPlace)} · ${versesShown} ayat · ${juzLabel}`}
        />
      </p>
    </div>
  </header>

  <div class="tools">
    <MushafModeSwitch mode="surah" surahHref={`/quran/${chapter.id}`} pageHref={surahPageUrl(chapter.id)} />
    <LanguageSwitch />
    <a class="pill" href={studyUrl(chapter.id)}><T en="Study" id="Belajar" /></a>
  </div>

  <main class="book">
    {pages.map((page) => <MushafPage data={page} focus={chapter.id} />)}
  </main>
</Base>

<style>
  /* Phones: the language switch gets its own row under Surah | Page and Study */
  @media (max-width: 30rem) {
    .tools :global(.language-switch) {
      order: 1;
      flex-basis: 100%;
      justify-content: center;
    }
  }

  .bar,
  .tools {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: 46rem;
    margin-inline: auto;
    padding: 0.8rem var(--gutter) 0;
  }

  .tools {
    flex-wrap: wrap; /* never run off the side of a phone */
    gap: 0.75rem;
    justify-content: space-between;
    padding-bottom: 0.9rem;
  }

  .names h1 {
    font-size: 1.2rem;
  }

  .names h1 span {
    color: var(--muted);
    font-weight: 500;
  }

  .names p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .round {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--gold-500) 60%, transparent);
    border-radius: 50%;
    color: var(--gold-300);
  }

  .pill {
    padding: 0.45rem 1rem;
    border: 1px solid color-mix(in srgb, var(--gold-500) 60%, transparent);
    border-radius: var(--radius-pill);
    color: var(--gold-300);
    font-size: 0.95rem;
    text-decoration: none;
  }

  /* The surah's pages, one under the other */
  .book {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-inline: auto;
    padding: 0 0.4rem 2.5rem;
  }
</style>
