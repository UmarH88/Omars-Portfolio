---
/*
  404 page: shown for any address that doesn't exist.
  Astro builds it as 404.html, which Cloudflare Pages serves automatically.
*/
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" theme="space">
  <main class="not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>This shelf is empty.</h1>
    <p class="text">
      The page you’re looking for doesn’t exist, or hasn’t been built yet. This library is still
      growing.
    </p>

    <nav class="links" aria-label="Pages that exist">
      <a class="primary" href="/quran">Read the Quran</a>
      <a href="/">Back to the start</a>
    </nav>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    place-content: center;
    min-height: 100dvh;
    max-width: 32rem;
    margin-inline: auto;
    padding: 2rem var(--gutter);
    text-align: center;
  }

  /* Big faint number with a soft cyan glow */
  .code {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 30vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 60%, transparent);
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(1.8rem, 7vw, 2.4rem);
  }

  .text {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .links a {
    padding: 0.8rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--text) 25%, transparent);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
  }

  .links a.primary {
    border-color: transparent;
    background: var(--white);
    color: var(--navy-950);
  }
</style>
